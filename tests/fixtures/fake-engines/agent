#!/usr/bin/env node
/**
 * Fake Cursor `agent` binary for setup readiness tests.
 * Supports: --version | status
 * FAKE_CURSOR_LOGIN=logged-out → status prints "Not logged in"
 * FAKE_ENGINE_SCENARIO=SLEEP → hang
 */
import process from 'node:process';

const args = process.argv.slice(2);
const scenario = process.env.FAKE_ENGINE_SCENARIO || 'OK';
const loginMode = process.env.FAKE_CURSOR_LOGIN || 'logged-in';

if (scenario === 'SLEEP') {
  const ms = Number(process.env.FAKE_ENGINE_SLEEP_MS || 30000);
  setTimeout(() => {
    process.stdout.write('2026.01.01-sleep\n');
    process.exit(0);
  }, ms);
} else if (args.length === 1 && args[0] === '--version') {
  process.stdout.write('2026.08.11-fake\n');
  process.exit(0);
} else if (args.length === 1 && args[0] === 'status') {
  if (loginMode === 'logged-out') {
    process.stdout.write('Not logged in\n');
  } else {
    process.stdout.write('✓ Logged in as fake@example.com\n');
  }
  process.exit(0);
} else {
  process.stderr.write(`fake-agent: unexpected args: ${args.join(' ')}\n`);
  process.exit(0);
}
